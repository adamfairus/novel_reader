---
import Layout from '../layouts/Layout.astro';
import { INITIAL_NOVELS } from '../lib/novels';
---

<Layout title="Katalog Novel">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <!-- Header Section -->
    <div class="mb-10 sm:mb-14">
      <div class="flex items-center gap-2 mb-2 text-xs font-medium text-sky-400 tracking-wider uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        Perpustakaan Pribadi
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)]">
        Koleksi Novel
      </h1>
      <p class="mt-2 text-base text-[var(--text-secondary)] max-w-2xl">
        Koleksi novel terjemahan berkualitas tinggi dengan pengalaman membaca bersih, bebas gangguan, dan mode terjemahan instan.
      </p>
    </div>

    <!-- Novel Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {INITIAL_NOVELS.map((novel) => (
        <article class="group rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] overflow-hidden flex flex-col hover:border-[var(--text-muted)] transition-all duration-200">
          <!-- Cover & Badge -->
          <div class="relative aspect-[3/4] bg-[var(--bg-elevated)] overflow-hidden">
            <img
              src={novel.cover_url}
              alt={novel.title}
              loading="lazy"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)] via-transparent to-transparent opacity-80"></div>
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs">
              <span class="px-2.5 py-1 rounded-md bg-[var(--bg-surface)]/90 backdrop-blur-md border border-[var(--border-color)] font-medium text-[var(--text-primary)]">
                {novel.total_chapters} Bab
              </span>
            </div>
          </div>

          <!-- Novel Info -->
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <p class="text-xs font-medium text-sky-400 mb-1">{novel.author}</p>
              <h2 class="text-lg font-bold text-[var(--text-primary)] tracking-tight line-clamp-2 group-hover:text-sky-400 transition-colors">
                {novel.title}
              </h2>
              {novel.description && (
                <p class="mt-2 text-xs text-[var(--text-secondary)] line-clamp-3 leading-relaxed">
                  {novel.description}
                </p>
              )}
            </div>

            <!-- Action Buttons -->
            <div class="mt-5 pt-4 border-t border-[var(--border-color)] flex items-center justify-between gap-3">
              <a
                href={`/novel/${novel.slug}`}
                class="flex-1 text-center py-2 px-3 text-xs font-semibold rounded-lg bg-[var(--bg-elevated)] hover:bg-[var(--border-color)] text-[var(--text-primary)] border border-[var(--border-color)] transition-colors"
              >
                Daftar Bab
              </a>
              <a
                href={`/novel/${novel.slug}/1`}
                class="flex-1 text-center py-2 px-3 text-xs font-semibold rounded-lg bg-sky-500 hover:bg-sky-400 text-white shadow-sm transition-colors"
              >
                Mulai Baca
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
