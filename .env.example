# Supabase (Metadata & User Bookmarks)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare R2 Public URL (Untuk Fetch Konten Bab On-Demand)
PUBLIC_R2_URL=https://pub-your-id.r2.dev

# Cloudflare R2 API Credentials (Hanya dipakai oleh script upload lokal, JANGAN di-commit)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=novel-reader
